PORT=3000
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
ML_SERVICE_URL=http://127.0.0.1:8000
ML_INTERNAL_TOKEN=USE_THE_SAME_PRIVATE_RANDOM_TOKEN_AS_ML_SERVICE
# Optional state-specific Malaysia Holiday API. Set to the bakery's state code.
# BAKERY_HOLIDAY_STATE=KUL
# Optional server-only FCM credential file path; never bundle its JSON in Flutter.
# GOOGLE_APPLICATION_CREDENTIALS=C:\protected\firebase-service-account.json
SURPLUS_ALERT_THRESHOLD_PCT=20
# Optional server-only next-day OpenWeather 5-day/3-hour forecast.
# Without these, prediction uses only an explicitly configured weather fallback.
# OPENWEATHER_API_KEY=YOUR_SERVER_ONLY_KEY
# BAKERY_LATITUDE=3.1390
# BAKERY_LONGITUDE=101.6869
